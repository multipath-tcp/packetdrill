// This test case covers: https://github.com/multipath-tcp/mptcp_net-next/issues/640
// writev() must still send data copied before a later iovec faults

--tolerance_usecs=100000
`../common/defaults.sh
 ethtool -K tun0 gso off tso off
`

+0     socket(..., SOCK_STREAM, IPPROTO_MPTCP) = 3
+0     setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0

+0     bind(3, ..., ...) = 0
+0     listen(3, 1) = 0
+0.1     <  S   0:0(0)                       win 32792  <mss 1460, sackOK, nop, nop, nop, wscale 7, mpcapable v1 flags[flag_h] nokey>
+0       >  S.  0:0(0)             ack 1                <mss 1460, nop, nop, sackOK, nop, wscale 8, mpcapable v1 flags[flag_h] key[skey]>
+0.2     <   .  1:1(0)             ack 1     win 257                                               <mpcapable v1 flags[flag_h] key[ckey=2, skey]>
+0     accept(3, ..., ...) = 4

+0     writev(4, [{..., 32728}, {NULL, 4096}], 2) = 32728
+0       >   .  1:1437(1436)       ack 1                <dss dack4=1    dsn8=1    ssn=1    dll=1436 nocs,     nop, nop>
